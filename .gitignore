# OS generated files
.DS_Store
Thumbs.db

# IDE files
.idea/
*.iml
.vscode/settings.json

# Local scratch/debug output, never committed
scratch/

# Capacitor's node_modules -- package.json/package-lock.json ARE committed
# for reproducibility, but table/ itself still has none of this (stays
# dependency-free, loaded as plain <script> tags; see android/README.md)
node_modules/

# Generated by tools/build-table.js (Android roadmap step 2) -- derived
# output, regenerate with `node tools/build-table.js`, never committed
table/dist/

# Android/Gradle (pre-emptive, for the planned Android port — none of this
# exists yet, but keeping secrets and build output out of git from day one
# matters more than adding these patterns when they're first needed)
.gradle/
build/
*/build/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
local.properties
*.keystore
*.jks
android/keystore/
android/keystore.properties
play-service-account.json
*.apk
